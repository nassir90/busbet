# Required: NTA API key from https://developer.nationaltransport.ie/
NTA_API_KEY=your_nta_api_key_here

# Storage backend: 'mock' | 'sqlite' (default) | 'supabase'
# Use 'mock' for instant local dev without importing GTFS data
STORAGE_BACKEND=sqlite

# SQLite database file path (used when STORAGE_BACKEND=sqlite)
DATABASE_URL=./data/busbet.db

# Supabase credentials (used when STORAGE_BACKEND=supabase)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your_anon_key
