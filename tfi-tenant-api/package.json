    "simulate": "tsx scripts/simulate-reports.ts",
    "evaluate": "tsx scripts/evaluate-reports.ts",
    "verify-migration": "tsx scripts/verify-migration.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@libsql/client": "^0.17.0"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^6.0.3"
  }
}
