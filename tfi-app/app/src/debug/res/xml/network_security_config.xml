<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug override of app/src/main/res/xml/network_security_config.xml. Same resource name, so the
  debug source set wins when building debug and this permissive file is absent from release APKs
  entirely.

  Debug keeps cleartext because that is where http backends are meant to live now: a laptop on the
  LAN, a tailnet peer, the on-device server, an emulator's 10.0.2.2 — none of which have
  certificates. Settings still warns when a configured backend is http, and that warning is honest
  here in a way it would not be in release.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
