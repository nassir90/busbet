[Unit]
Description=GTFS-R bus data collector
After=network.target

[Service]
Slice=lab.slice
Type=simple
WorkingDirectory=/home/lab/Projects/busbet/gtfsr-collector
# Bundled to plain JS and run by node itself: `npx tsx` was three node processes (npm, the tsx
# CLI and the real one with tsx's loader in it), ~61 MB more than the collector needs.
ExecStartPre=/usr/bin/npm run --silent build
ExecStart=/usr/bin/node dist/collect.js
EnvironmentFile=/home/lab/Projects/busbet/gtfsr-collector/.env
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
